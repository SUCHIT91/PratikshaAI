[app]
title = Pratiksha AI
package.name = pratiksha
package.domain = in.pratiksha.ai
source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas,db,json,txt,ttf,otf
version = 1.0
requirements = python3,kivy,requests,plyer
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,RECORD_AUDIO,MODIFY_AUDIO_SETTINGS,VIBRATE
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
